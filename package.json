{
  "name": "quizzeira",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @quizzeira/api",
    "dev:web": "npm run dev -w @quizzeira/web",
    "dev:quiz-corrector": "npm run dev -w @quizzeira/quiz-corrector",
    "dev:question-updater": "npm run dev -w @quizzeira/question-updater",
    "build": "npm run build -w @quizzeira/shared && npm run build -w @quizzeira/api && npm run build -w @quizzeira/web",
    "db:migrate": "npm run db:migrate -w @quizzeira/api",
    "db:seed": "npm run db:seed -w @quizzeira/api"
  }
}
