{
  "name": "quizzeira",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @quizzeira/api",
    "dev:web": "npm run dev -w @quizzeira/web",
    "dev:quiz-corrector": "npm run dev -w @quizzeira/quiz-corrector",
    "dev:question-updater": "npm run dev -w @quizzeira/question-updater",
    "dev:question-generator": "npm run dev -w @quizzeira/question-generator",
    "dev:exam-crawler": "npm run dev -w @quizzeira/exam-crawler",
    "build": "npm run build -w @quizzeira/shared && npm run build -w @quizzeira/api && npm run build -w @quizzeira/web",
    "test:i18n": "node --import tsx --test apps/web/src/i18n/locale.spec.ts",
    "test:shared": "node --import tsx --test packages/shared/src/**/*.spec.ts",
    "db:migrate": "npm run db:migrate -w @quizzeira/api",
    "db:seed": "npm run db:seed -w @quizzeira/api"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
