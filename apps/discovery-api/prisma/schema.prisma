// Concept: Ingestion + Source registry + Document store (metadata)
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DISCOVERY_DATABASE_URL")
}

enum SourceStatus {
  active
  broken
  proposed
  disabled
}

enum SourceTrust {
  high
  medium
  low
}

enum CrawlStrategy {
  listing_links
  banca_portal
  fixture
  // FGV's OAB portal: the document list is behind an ASP.NET postback, so it
  // needs its own crawl. See docs/oab-exam.md.
  oab_fgv
}

enum SourceKind {
  banca_portal
  org_portal
  aggregator
  official_gazette
  legislation
  educational_site
  open_textbook
  standards_body
  question_bank_public
  exam_specific
  fixture
}

enum DiscoveryMode {
  listing
  topic_query
  direct
  custom
}

enum ExamKind {
  concurso
  oab
  certification
  vestibular
  other
}

enum ArtifactKindHint {
  edital
  retificacao
  programa
  prova
  gabarito
  padrao_resposta
  apostila
  lei
  artigo
  manual
  listing
  unknown
}

enum RoleHint {
  specification
  evidence
  knowledge
  administrative
  unknown
}

enum ArtifactKind {
  edital
  prova
  gabarito
  programa
  other
}

enum ExamStatus {
  open
  closed
  unknown
}

enum CrawlRunStatus {
  running
  ok
  partial
  failed
}

model Source {
  id            String       @id
  domain        String
  name          String
  startUrls     Json
  strategy      CrawlStrategy @default(listing_links)
  kind          SourceKind   @default(aggregator)
  discoveryMode DiscoveryMode @default(listing)
  allowedRoles  Json         @default("[]")
  authorityScore Float?
  licenseNote   String?
  robotsCache   Json?
  linkSelector  String?
  linkPatterns  Json
  openPatterns  Json
  trust         SourceTrust  @default(medium)
  status        SourceStatus @default(active)
  enabled       Boolean      @default(true)
  intervalSec   Int          @default(1800)
  politenessMs  Int          @default(1000)
  failCount     Int          @default(0)
  lastOkAt      DateTime?
  lastError     String?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  exams         Exam[]
  artifacts     Artifact[]
  proposals     SourceProposal[] @relation("ProposedFrom")
  runs          CrawlRun[]
  fingerprints  ListingFingerprint[]

  @@index([status])
  @@index([domain])
}

model SourceProposal {
  id          String       @id @default(cuid())
  domain      String
  name        String
  startUrls   Json
  reason      String?
  status      SourceStatus @default(proposed)
  sourceId    String?
  source      Source?      @relation("ProposedFrom", fields: [sourceId], references: [id])
  createdAt   DateTime     @default(now())
  reviewedAt  DateTime?

  @@index([status])
}

model Exam {
  id              String     @id
  examSlug        String
  title           String
  org             String?
  banca           String?
  emphasis        Json
  editalUrl       String?
  listingUrl      String
  kind            ExamKind   @default(concurso)
  editionKey      String?
  detailUrl       String?
  registrationEnd DateTime?
  statusSource    String?
  positions       Json?
  status          ExamStatus @default(open)
  sourceId        String
  source          Source     @relation(fields: [sourceId], references: [id])
  sourceDomain    String
  discoveredAt    DateTime   @default(now())
  lastSeenAt      DateTime   @default(now())
  artifacts       Artifact[]

  @@unique([examSlug, listingUrl])
  @@index([status])
  @@index([examSlug])
  @@index([kind])
}

model Artifact {
  id           String           @id @default(cuid())
  examId       String?
  exam         Exam?            @relation(fields: [examId], references: [id])
  sourceId     String?
  source       Source?          @relation(fields: [sourceId], references: [id])
  kind         ArtifactKind
  kindHint     ArtifactKindHint @default(unknown)
  roleHint     RoleHint         @default(unknown)
  anchorLabel  String?
  topicQueryId String?
  topicQuery   TopicQuery?      @relation(fields: [topicQueryId], references: [id])
  contentHash  String?
  etag         String?
  lastModified DateTime?
  fetchSignals Json?
  url          String?
  storageKey   String?
  checksum     String?
  contentType  String?
  byteSize     Int?
  fetchedAt    DateTime         @default(now())
  published    Boolean          @default(false)

  @@index([examId])
  @@index([kind, published])
  @@index([contentHash])
}

model TopicQuery {
  id               String     @id @default(cuid())
  examId           String
  syllabusNodeId   String
  canonicalKey     String
  queries          Json
  status           String     @default("queued")
  candidatesFound  Int        @default(0)
  candidatesStored Int        @default(0)
  attempts         Int        @default(0)
  nextRunAt        DateTime?
  createdAt        DateTime   @default(now())
  finishedAt       DateTime?
  artifacts        Artifact[]

  @@index([status, nextRunAt])
  @@index([examId, syllabusNodeId])
}

model DomainStats {
  domain           String   @id
  fetched          Int      @default(0)
  becameKnowledge  Int      @default(0)
  rejectedLowValue Int      @default(0)
  avgDensity       Float?
  authority        Float?
  updatedAt        DateTime @updatedAt
}

/// Per-source listing digest. A crawl pass that matches the stored digest is
/// skipped entirely, so unchanged portals cost one page fetch instead of a full
/// re-ingest. History rows make "this portal went stale" visible in admin.
model ListingFingerprint {
  id          String   @id @default(cuid())
  sourceId    String
  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  startUrl    String
  fingerprint String
  listingCount Int     @default(0)
  seenAt      DateTime @default(now())

  @@unique([sourceId, startUrl])
  @@index([sourceId, seenAt])
}

/// Small key/value control plane (admin "crawl now" handoff). Postgres-backed so
/// the flag outlives a crawler restart.
model ControlFlag {
  id        String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt
}

model CrawlRun {
  id               String         @id
  sourceId         String?
  source           Source?        @relation(fields: [sourceId], references: [id])
  startedAt        DateTime
  finishedAt       DateTime?
  status           CrawlRunStatus @default(running)
  sourcesOk        Int            @default(0)
  sourcesFailed    Int            @default(0)
  openDiscovered   Int            @default(0)
  proposedSources  Int            @default(0)
  errors           Json
}
