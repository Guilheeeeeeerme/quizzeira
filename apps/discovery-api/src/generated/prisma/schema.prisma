// Concept: Ingestion + Source registry + Document store (metadata)
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DISCOVERY_DATABASE_URL")
}

enum SourceStatus {
  active
  broken
  proposed
  disabled
}

enum SourceTrust {
  high
  medium
  low
}

enum CrawlStrategy {
  listing_links
  banca_portal
  fixture
}

enum ArtifactKind {
  edital
  prova
  gabarito
  programa
  other
}

enum ExamStatus {
  open
  closed
  unknown
}

enum CrawlRunStatus {
  running
  ok
  partial
  failed
}

model Source {
  id           String               @id
  domain       String
  name         String
  startUrls    Json
  strategy     CrawlStrategy        @default(listing_links)
  linkSelector String?
  linkPatterns Json
  openPatterns Json
  trust        SourceTrust          @default(medium)
  status       SourceStatus         @default(active)
  enabled      Boolean              @default(true)
  intervalSec  Int                  @default(1800)
  politenessMs Int                  @default(1000)
  failCount    Int                  @default(0)
  lastOkAt     DateTime?
  lastError    String?
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  exams        Exam[]
  artifacts    Artifact[]
  proposals    SourceProposal[]     @relation("ProposedFrom")
  runs         CrawlRun[]
  fingerprints ListingFingerprint[]

  @@index([status])
  @@index([domain])
}

model SourceProposal {
  id         String       @id @default(cuid())
  domain     String
  name       String
  startUrls  Json
  reason     String?
  status     SourceStatus @default(proposed)
  sourceId   String?
  source     Source?      @relation("ProposedFrom", fields: [sourceId], references: [id])
  createdAt  DateTime     @default(now())
  reviewedAt DateTime?

  @@index([status])
}

model Exam {
  id           String     @id
  examSlug     String
  title        String
  org          String?
  banca        String?
  emphasis     Json
  editalUrl    String?
  listingUrl   String
  status       ExamStatus @default(open)
  sourceId     String
  source       Source     @relation(fields: [sourceId], references: [id])
  sourceDomain String
  discoveredAt DateTime   @default(now())
  lastSeenAt   DateTime   @default(now())
  artifacts    Artifact[]

  @@unique([examSlug, listingUrl])
  @@index([status])
  @@index([examSlug])
}

model Artifact {
  id          String       @id @default(cuid())
  examId      String?
  exam        Exam?        @relation(fields: [examId], references: [id])
  sourceId    String?
  source      Source?      @relation(fields: [sourceId], references: [id])
  kind        ArtifactKind
  url         String?
  storageKey  String?
  checksum    String?
  contentType String?
  byteSize    Int?
  fetchedAt   DateTime     @default(now())
  published   Boolean      @default(false)

  @@index([examId])
  @@index([kind, published])
}

/// Per-source listing digest. A crawl pass that matches the stored digest is
/// skipped entirely, so unchanged portals cost one page fetch instead of a full
/// re-ingest. History rows make "this portal went stale" visible in admin.
model ListingFingerprint {
  id           String   @id @default(cuid())
  sourceId     String
  source       Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  startUrl     String
  fingerprint  String
  listingCount Int      @default(0)
  seenAt       DateTime @default(now())

  @@unique([sourceId, startUrl])
  @@index([sourceId, seenAt])
}

/// Small key/value control plane (admin "crawl now" handoff). Postgres-backed so
/// the flag outlives a crawler restart.
model ControlFlag {
  id        String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt
}

model CrawlRun {
  id              String         @id
  sourceId        String?
  source          Source?        @relation(fields: [sourceId], references: [id])
  startedAt       DateTime
  finishedAt      DateTime?
  status          CrawlRunStatus @default(running)
  sourcesOk       Int            @default(0)
  sourcesFailed   Int            @default(0)
  openDiscovered  Int            @default(0)
  proposedSources Int            @default(0)
  errors          Json
}
