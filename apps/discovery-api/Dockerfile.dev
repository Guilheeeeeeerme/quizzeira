FROM node:22-alpine

WORKDIR /app

COPY package.json ./
COPY apps/discovery-api/package.json ./apps/discovery-api/
COPY packages/shared/package.json ./packages/shared/

RUN npm install

COPY packages/shared ./packages/shared
COPY apps/discovery-api ./apps/discovery-api

RUN npm run build -w @quizzeira/shared && npm run db:generate -w @quizzeira/discovery-api

WORKDIR /app/apps/discovery-api

RUN chmod +x docker-entrypoint.sh

EXPOSE 3010

CMD ["sh", "docker-entrypoint.sh"]
