FROM node:22-alpine

WORKDIR /app

COPY package.json ./
COPY apps/question-updater/package.json ./apps/question-updater/
COPY packages/shared/package.json ./packages/shared/
COPY packages/worker-kit/package.json ./packages/worker-kit/

RUN npm install

COPY packages/shared ./packages/shared
COPY packages/worker-kit ./packages/worker-kit
COPY apps/question-updater ./apps/question-updater

RUN npm run build -w @quiz-app/shared

WORKDIR /app/apps/question-updater

CMD ["npm", "run", "dev"]
