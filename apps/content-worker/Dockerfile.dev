FROM node:22-alpine

WORKDIR /app

COPY package.json ./
COPY apps/content-worker/package.json ./apps/content-worker/
COPY packages/shared/package.json ./packages/shared/
COPY packages/worker-kit/package.json ./packages/worker-kit/

RUN npm install

COPY packages/shared ./packages/shared
COPY packages/worker-kit ./packages/worker-kit
COPY apps/content-worker ./apps/content-worker

RUN npm run build -w @quizzeira/shared

WORKDIR /app/apps/content-worker

CMD ["sh", "-c", "npm run dev -w @quizzeira/shared & npm run dev"]
