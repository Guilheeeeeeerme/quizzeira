FROM node:22-alpine

WORKDIR /app

COPY package.json ./
COPY apps/discovery-portal-monitor/package.json ./apps/discovery-portal-monitor/
COPY packages/shared/package.json ./packages/shared/
COPY packages/worker-kit/package.json ./packages/worker-kit/

RUN npm install

COPY packages/shared ./packages/shared
COPY packages/worker-kit ./packages/worker-kit
COPY apps/discovery-portal-monitor ./apps/discovery-portal-monitor

RUN npm run build -w @quizzeira/shared

WORKDIR /app/apps/discovery-portal-monitor

CMD ["npm", "run", "dev"]
