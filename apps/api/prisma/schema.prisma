// Concept: Sampling (not RAG) + Grading — the study runtime's own state.
//
// This schema holds users, study configs (Topic), and attempts. It deliberately
// does NOT hold a question bank: questions are sampled from content-api's
// published set and materialized per attempt. Anything curriculum-shaped
// (difficulty levels, topic attachments/links, question pools) was removed —
// producing questions is Content's job, not Study's.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum QuestionType {
  MULTIPLE_CHOICE
  OPEN
}

enum AttemptStatus {
  GENERATING
  IN_PROGRESS
  PENDING
  IN_CORRECTION
  CORRECTED
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  displayName  String?
  role         UserRole      @default(USER)
  createdAt    DateTime      @default(now())
  attempts     QuizAttempt[]
  topics       Topic[]
}

/// A learner's study config for one open exam. `guidelines` carries the
/// examSlug marker that links it to the Discovery catalog.
model Topic {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  guidelines      String        @db.Text
  presetSlug      String?
  preferredLocale String?
  lastUsedAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  questions       Question[]
  attempts        QuizAttempt[]

  @@index([userId])
  @@index([lastUsedAt])
}

/// A question as it was shown in one attempt — a snapshot, not a pool. The
/// canonical row lives in quizzeira_content; this copy keeps a submitted
/// attempt readable even if the published item is later changed or unpublished.
model Question {
  id               String            @id @default(cuid())
  topicId          String?
  topic            Topic?            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sourceAttemptId  String?
  type             QuestionType
  prompt           String            @db.Text
  options          Json?
  /** Optional stem figures: QuestionMediaRef[] */
  promptMedia      Json?
  /** Optional per-option figures: (QuestionMediaRef[] | null)[] */
  optionMedia      Json?
  correctIndex     Int?
  referenceAnswer  String?           @db.Text
  explanation      String?           @db.Text
  isActive         Boolean           @default(true)
  lastReviewedAt   DateTime?
  answers          QuizAnswer[]
  attemptQuestions AttemptQuestion[]

  @@index([topicId])
}

model QuizAttempt {
  id                  String            @id @default(cuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id])
  topicId             String?
  topic               Topic?            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  locale              String            @default("en")
  focusText           String?           @db.Text
  /// Session length in minutes; null = default short pill.
  durationMinutes     Int?
  score               Int?
  maxScore            Int               @default(5)
  generalComment      String?           @db.Text
  status              AttemptStatus     @default(IN_PROGRESS)
  startedAt           DateTime          @default(now())
  submittedAt         DateTime?
  correctedAt         DateTime?
  correctionStartedAt DateTime?
  generationStartedAt DateTime?
  answers             QuizAnswer[]
  questions           AttemptQuestion[]

  @@index([topicId])
  @@index([status])
}

model AttemptQuestion {
  id         String      @id @default(cuid())
  attemptId  String
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question    @relation(fields: [questionId], references: [id])
  sortOrder  Int

  @@unique([attemptId, questionId])
}

model QuizAnswer {
  id                   String      @id @default(cuid())
  attemptId            String
  attempt              QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId           String
  question             Question    @relation(fields: [questionId], references: [id])
  selectedIndex        Int?
  openText             String?     @db.Text
  grade                Int?
  comment              String?     @db.Text
  explanation          String?     @db.Text
  correctAnswerSummary String?     @db.Text
  isCorrect            Boolean?
  correctedAt          DateTime?

  @@unique([attemptId, questionId])
}
