generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum QuestionType {
  MULTIPLE_CHOICE
  OPEN
}

enum AttemptStatus {
  GENERATING
  IN_PROGRESS
  PENDING
  IN_CORRECTION
  CORRECTED
}

enum AttachmentKind {
  TEXT
  PDF
  IMAGE
}

enum LinkFetchStatus {
  PENDING
  OK
  FAILED
  SKIPPED
}

enum UserRole {
  USER
  ADMIN
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  displayName  String?
  role         UserRole      @default(USER)
  createdAt    DateTime      @default(now())
  attempts     QuizAttempt[]
  topics       Topic[]
}

model DifficultyLevel {
  id        Int           @id @default(autoincrement())
  slug      String        @unique
  label     String
  sortOrder Int
  questions Question[]
  attempts  QuizAttempt[]
}

model Topic {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  guidelines      String            @db.Text
  presetSlug      String?
  preferredLocale String?
  lastUsedAt      DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  attachments     TopicAttachment[]
  links           TopicLink[]
  questions       Question[]
  attempts        QuizAttempt[]

  @@index([userId])
  @@index([lastUsedAt])
}

model TopicAttachment {
  id            String         @id @default(cuid())
  topicId       String
  topic         Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  kind          AttachmentKind
  filename      String
  storageKey    String
  mimeType      String
  extractedText String?        @db.LongText
  byteSize      Int
  createdAt     DateTime       @default(now())

  @@index([topicId])
}

model TopicLink {
  id          String          @id @default(cuid())
  topicId     String
  topic       Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  url         String          @db.Text
  label       String?
  fetchedText String?         @db.LongText
  fetchStatus LinkFetchStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([topicId])
}

model Question {
  id               String                   @id @default(cuid())
  levelId          Int?
  level            DifficultyLevel?         @relation(fields: [levelId], references: [id])
  topicId          String?
  topic            Topic?                   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sourceAttemptId  String?
  type             QuestionType
  prompt           String                   @db.Text
  options          Json?
  correctIndex     Int?
  referenceAnswer  String?                  @db.Text
  explanation      String?                  @db.Text
  isActive         Boolean                  @default(true)
  lastReviewedAt   DateTime?
  answers          QuizAnswer[]
  attemptQuestions AttemptQuestion[]
  updateProposals  QuestionUpdateProposal[]

  @@index([topicId])
  @@index([levelId])
}

model QuestionUpdateProposal {
  id            String         @id @default(cuid())
  questionId    String
  question      Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  proposedPatch Json
  reason        String?        @db.Text
  status        ProposalStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  reviewedAt    DateTime?
  reviewedById  String?

  @@index([status, createdAt])
  @@index([questionId])
  @@map("question_update_proposals")
}

model QuizAttempt {
  id                  String            @id @default(cuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id])
  levelId             Int?
  level               DifficultyLevel?  @relation(fields: [levelId], references: [id])
  topicId             String?
  topic               Topic?            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  locale              String            @default("en")
  focusText           String?           @db.Text
  score               Int?
  maxScore            Int               @default(5)
  generalComment      String?           @db.Text
  status              AttemptStatus     @default(IN_PROGRESS)
  startedAt           DateTime          @default(now())
  submittedAt         DateTime?
  correctedAt         DateTime?
  correctionStartedAt DateTime?
  generationStartedAt DateTime?
  answers             QuizAnswer[]
  questions           AttemptQuestion[]

  @@index([topicId])
  @@index([status])
}

model AttemptQuestion {
  id         String      @id @default(cuid())
  attemptId  String
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question    @relation(fields: [questionId], references: [id])
  sortOrder  Int

  @@unique([attemptId, questionId])
}

model QuizAnswer {
  id            String      @id @default(cuid())
  attemptId     String
  attempt       QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question    @relation(fields: [questionId], references: [id])
  selectedIndex Int?
  openText      String?     @db.Text
  grade         Int?
  comment       String?     @db.Text
  explanation   String?     @db.Text
  correctAnswerSummary String? @db.Text
  isCorrect     Boolean?
  correctedAt   DateTime?

  @@unique([attemptId, questionId])
}
