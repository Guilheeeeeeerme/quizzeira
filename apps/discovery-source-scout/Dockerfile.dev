FROM node:22-alpine

WORKDIR /app

COPY package.json ./
COPY apps/discovery-source-scout/package.json ./apps/discovery-source-scout/
COPY packages/shared/package.json ./packages/shared/
COPY packages/worker-kit/package.json ./packages/worker-kit/

RUN npm install

COPY packages/shared ./packages/shared
COPY packages/worker-kit ./packages/worker-kit
COPY apps/discovery-source-scout ./apps/discovery-source-scout

RUN npm run build -w @quizzeira/shared

WORKDIR /app/apps/discovery-source-scout

CMD ["npm", "run", "dev"]
