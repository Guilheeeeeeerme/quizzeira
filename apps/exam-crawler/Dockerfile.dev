# Playwright browsers are installed in the image; keep node_modules local via compose volume.
FROM mcr.microsoft.com/playwright:v1.50.1-jammy

WORKDIR /app

COPY package.json ./
COPY apps/exam-crawler/package.json ./apps/exam-crawler/
COPY packages/shared/package.json ./packages/shared/
COPY packages/worker-kit/package.json ./packages/worker-kit/

RUN npm install

COPY packages/shared ./packages/shared
COPY packages/worker-kit ./packages/worker-kit
COPY apps/exam-crawler ./apps/exam-crawler

RUN npm run build -w @quizzeira/shared

WORKDIR /app/apps/exam-crawler

CMD ["npm", "run", "dev"]
