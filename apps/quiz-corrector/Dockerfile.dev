FROM node:22-alpine

WORKDIR /app

COPY package.json ./
COPY apps/quiz-corrector/package.json ./apps/quiz-corrector/
COPY packages/shared/package.json ./packages/shared/
COPY packages/worker-kit/package.json ./packages/worker-kit/

RUN npm install

COPY packages/shared ./packages/shared
COPY packages/worker-kit ./packages/worker-kit
COPY apps/quiz-corrector ./apps/quiz-corrector

RUN npm run build -w @quizzeira/shared

WORKDIR /app/apps/quiz-corrector

CMD ["sh", "-c", "npm run dev -w @quizzeira/shared & npm run dev"]
