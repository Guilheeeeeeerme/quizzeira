// Concept: Question bank + Embeddings (quizzeira_content)
//
// Content owns every question that exists. The study API only ever reads rows
// with status = published, and only the Eval stage (content-quality) may set it.
generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("CONTENT_DATABASE_URL")
  extensions = [vector]
}

enum ExtractionStatus {
  pending
  extracting
  extracted
  failed
}

enum DocumentKind {
  edital
  prova
  gabarito
  programa
  other
}

enum DocumentRole {
  specification
  evidence
  knowledge
  administrative
  mixed
  unknown
}

enum SectionRole {
  syllabus
  vacancies
  schedule
  registration
  exam_structure
  legal_disposition
  instructional
  content
  legal_article
  question_block
  answer_key
  nav
  other
}

enum EligibilityStatus {
  eligible
  ineligible
  parked
}

enum QuestionItemStatus {
  draft
  needs_review
  published
  failed
}

enum QuestionItemOrigin {
  extraction
  generation
  transcription
}

enum QuestionItemType {
  MULTIPLE_CHOICE
  OPEN
}

enum GenerationRunStatus {
  queued
  running
  ok
  partial
  failed
}

/// A source PDF/HTML pulled from Discovery's Document store. `discoveryArtifactId`
/// is the join key back to quizzeira_discovery — the databases stay separate.
model Document {
  id                  String           @id @default(cuid())
  discoveryArtifactId String?          @unique
  examSlug            String
  examTitle           String?
  kind                DocumentKind     @default(other)
  role                DocumentRole     @default(unknown)
  roleConfidence      Float?
  roleMethod          String?
  subtype             String?
  contentHash         String?          @unique
  textHash            String?
  simhash             BigInt?
  nearDuplicateOfId   String?
  nearDuplicateOf     Document?        @relation("DocumentNearDup", fields: [nearDuplicateOfId], references: [id])
  nearDuplicates      Document[]       @relation("DocumentNearDup")
  rank                Float?
  language            String?
  normalizedKey       String?
  normalizerVersion   String?
  stats               Json?
  sourceUrl           String?
  storageKey          String?
  checksum            String?
  contentType         String?
  status              ExtractionStatus @default(pending)
  failReason          String?
  attempts            Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  sections            Section[]
  chunks              Chunk[]
  questionItems       QuestionItem[]
  previousQuestions   PreviousQuestion[]

  @@index([status])
  @@index([examSlug])
  @@index([role])
}

model Section {
  id         String      @id @default(cuid())
  documentId String
  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ordinal    Int
  path       Json
  heading    String?
  level      Int
  role       SectionRole @default(other)
  scores     Json
  charCount  Int
  pageRange  Json?
  chunks     Chunk[]

  @@unique([documentId, ordinal])
  @@index([documentId])
}

/// Chunked plain text plus its embedding. Retrieval over these chunks is what
/// grounds generation — the study runtime never touches them.
model Chunk {
  id                String             @id @default(cuid())
  documentId        String
  document          Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sectionId         String?
  section           Section?           @relation(fields: [sectionId], references: [id])
  ordinal           Int
  text              String
  tokenCount        Int                @default(0)
  contentHash       String
  eligibility       EligibilityStatus  @default(parked)
  eligibilityReason String?
  duplicateOfId     String?
  duplicateOf       Chunk?             @relation("ChunkDup", fields: [duplicateOfId], references: [id])
  duplicates        Chunk[]            @relation("ChunkDup")
  /// pgvector column; written and searched through raw SQL because Prisma has
  /// no native vector type. 768 dims matches text-embedding-004 / -3-small@768.
  embedding         Unsupported("vector(768)")?
  createdAt         DateTime           @default(now())
  syllabusMaps      ChunkSyllabusMap[]

  @@unique([documentId, ordinal])
  @@unique([documentId, contentHash])
  @@index([documentId])
  @@index([eligibility])
}

model Syllabus {
  id                 String         @id @default(cuid())
  examSlug           String
  version            Int
  sourceDocumentId   String
  sourceDocumentHash String
  status             String         @default("active")
  positions          Position[]
  nodes              SyllabusNode[]
  createdAt          DateTime       @default(now())

  @@unique([examSlug, version])
  @@index([examSlug, status])
}

model Position {
  id         String   @id @default(cuid())
  syllabusId String
  syllabus   Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  title      String
  slug       String
  implicit   Boolean  @default(false)
  vacancies  Int?

  @@unique([syllabusId, slug])
}

model SyllabusNode {
  id                 String   @id @default(cuid())
  syllabusId         String
  syllabus           Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  parentId           String?
  depth              Int
  ordinal            Int
  title              String
  rawText            String
  pathSlug           String
  canonicalSubjectId String?
  canonicalKey       String
  scope              String
  positionIds        Json
  questionCount      Int?
  weight             Float?
  status             String   @default("active")
  extraction         Json
  embedding          Unsupported("vector(768)")?

  @@index([syllabusId, depth])
  @@index([canonicalKey])
}

model ChunkSyllabusMap {
  chunkId        String
  chunk          Chunk  @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  syllabusNodeId String
  canonicalKey   String
  score          Float
  method         String

  @@id([chunkId, syllabusNodeId])
  @@index([syllabusNodeId, score])
  @@index([canonicalKey])
}

model KnowledgeUnit {
  id             String                       @id @default(cuid())
  syllabusNodeId String
  canonicalKey   String
  kind           String
  statement      String
  example        String?
  qualifiers     Json
  evidence       Json
  quality        Json
  status         String                       @default("active")
  mergedIntoId   String?
  extraction     Json
  embedding      Unsupported("vector(768)")?
  createdAt      DateTime                     @default(now())

  @@index([syllabusNodeId, status])
  @@index([canonicalKey, status])
}

model PreviousQuestion {
  id             String                       @id @default(cuid())
  fingerprint    String                       @unique
  documentId     String
  document       Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  examFamily     String
  banca          String?
  year           Int?
  position       String?
  phase          String?
  number         Int
  bookletType    String?
  passage        String?
  prompt         String
  options        Json
  correctIndex   Int?
  status         String                       @default("ok")
  subjectHint    String?
  syllabusNodeId String?
  canonicalKey   String?
  mapScore       Float?
  embedding      Unsupported("vector(768)")?

  @@index([banca, canonicalKey])
  @@index([examFamily, year])
}

model ExamStyleProfile {
  id                 String   @id @default(cuid())
  banca              String
  canonicalSubjectId String
  positionFamily     String?
  sampleSize         Int
  profile            Json
  updatedAt          DateTime @updatedAt

  @@unique([banca, canonicalSubjectId, positionFamily])
}

/// The canonical question row. Lifecycle: draft → (Eval) → published | failed,
/// with needs_review parking borderline items in the HITL queue.
model QuestionItem {
  id                  String             @id @default(cuid())
  /// Stable content hash so re-extraction and re-generation dedupe.
  fingerprint         String             @unique
  examSlug            String
  subject             String
  subjectSlug         String
  emphasis            String?
  origin              QuestionItemOrigin
  status              QuestionItemStatus @default(draft)
  type                QuestionItemType
  prompt              String
  options             Json?
  correctIndex        Int?
  referenceAnswer     String?
  explanation         String?
  locale              String             @default("pt")
  positionId          String?
  syllabusNodeId      String?
  canonicalKey        String?
  passage             String?
  knowledgeUnitIds    Json               @default("[]")
  distractorRationale Json?
  difficulty          Float?
  empiricalDifficulty Float?
  previousQuestionId  String?
  documentId          String?
  document            Document?          @relation(fields: [documentId], references: [id])
  generationRunId     String?
  generationRun       GenerationRun?     @relation(fields: [generationRunId], references: [id])
  qualityScore        Float?
  qualityNotes        String?
  failReasons         Json               @default("[]")
  reviewCount         Int                @default(0)
  stemEmbedding       Unsupported("vector(768)")?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  publishedAt         DateTime?
  reviews             QualityReview[]

  @@index([status, examSlug])
  @@index([examSlug, subjectSlug, status])
  @@index([status, createdAt])
  @@index([syllabusNodeId, status])
}

/// One Generation pass for an exam/subject pair. Keeps cost and yield visible.
model GenerationRun {
  id             String              @id @default(cuid())
  examSlug       String
  subject        String
  positionId     String?
  syllabusNodeId String?
  briefKey       String?
  promptVersion  String              @default("legacy-v0")
  difficulty     Float?
  tokensIn       Int?
  tokensOut      Int?
  status         GenerationRunStatus @default(queued)
  requested      Int                 @default(0)
  drafted        Int                 @default(0)
  chunksUsed     Int                 @default(0)
  model          String?
  error          String?
  startedAt      DateTime            @default(now())
  finishedAt     DateTime?
  questionItems  QuestionItem[]

  @@index([status, startedAt])
  @@index([examSlug])
}

/// Audit trail for the Eval stage. One row per structural+judge verdict, so a
/// publish decision is always explainable after the fact.
model QualityReview {
  id        String       @id @default(cuid())
  itemId    String
  item      QuestionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  stage     String
  decision  String
  score     Float
  notes     String?
  reasons   Json         @default("[]")
  model     String?
  createdAt DateTime     @default(now())

  @@index([itemId, createdAt])
  @@index([decision, createdAt])
}

/// Hourly stage funnel counters (§31.1) — admin dashboards without a log backend.
model StageMetric {
  id            String   @id @default(cuid())
  hourBucket    DateTime
  stage         String
  decision      String
  reason        String   @default("")
  count         Int      @default(0)
  tokensIn      Int      @default(0)
  tokensOut     Int      @default(0)
  durationMsSum Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([hourBucket, stage, decision, reason])
  @@index([hourBucket, stage])
}
