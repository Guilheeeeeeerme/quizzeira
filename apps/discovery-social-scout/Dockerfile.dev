# Lightweight Node worker (no Playwright). Talks to discovery-api only.
FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json ./
COPY apps/discovery-social-scout/package.json ./apps/discovery-social-scout/
COPY packages/shared/package.json ./packages/shared/
COPY packages/worker-kit/package.json ./packages/worker-kit/

RUN npm install

COPY packages/shared ./packages/shared
COPY packages/worker-kit ./packages/worker-kit
COPY apps/discovery-social-scout ./apps/discovery-social-scout

RUN npm run build -w @quizzeira/shared

WORKDIR /app/apps/discovery-social-scout

CMD ["npm", "run", "dev"]
