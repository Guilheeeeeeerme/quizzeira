# Quizzeira (Concurseria) — Dokploy runtime env, NAMES ONLY (values blank or
# commented; paste real values in the Dokploy panel). Surface mirrors the local
# `.env.sample` names exactly — same keys, production placements. Never commit
# real secrets.
#
# Hard rules baked into the defaults:
#  - Postgres = VPS `quizzeira-postgres` / `postgres-quizzeira` (pgvector) with
#    schemas quizzeira_study / quizzeira_discovery / quizzeira_content. Do NOT
#    point production at Supabase — Argus alone stays on Supabase Free.
#  - Object storage = Cloudflare R2 S3 API; set S3_BUCKET=quizzeira-objects
#    (compose default `quizzeira` is wrong for the provisioned bucket).
#  - Quizzeira LLM workers call Gemini and JEV directly.

# ── URLs ────────────────────────────────────────────────────────────────────
# Cloudflare Pages project quizzeira-app (<account>.pages.dev or custom `app.` host).
WEB_ORIGIN=https://app.concurseria.ferredemo.dev
API_ORIGIN=https://api.concurseria.ferredemo.dev
COOKIE_DOMAIN=.ferredemo.dev

# ── Postgres — VPS quizzeira-postgres (schema per plane, database `quizzeira`) ──
# No pooler on staging: DATABASE_* and *_DIRECT_URL may be identical.
# Host DNS name on quizzeira-internal: quizzeira-postgres (alias postgres-quizzeira).
# DATABASE_URL=postgresql://quizzeira:<password>@quizzeira-postgres:5432/quizzeira?schema=quizzeira_study
# DATABASE_DIRECT_URL=postgresql://quizzeira:<password>@quizzeira-postgres:5432/quizzeira?schema=quizzeira_study
# DISCOVERY_DATABASE_URL=postgresql://quizzeira:<password>@quizzeira-postgres:5432/quizzeira?schema=quizzeira_discovery
# DISCOVERY_DATABASE_DIRECT_URL=postgresql://quizzeira:<password>@quizzeira-postgres:5432/quizzeira?schema=quizzeira_discovery
# CONTENT_DATABASE_URL=postgresql://quizzeira:<password>@quizzeira-postgres:5432/quizzeira?schema=quizzeira_content
# CONTENT_DATABASE_DIRECT_URL=postgresql://quizzeira:<password>@quizzeira-postgres:5432/quizzeira?schema=quizzeira_content
# POSTGRES_USER=quizzeira
# POSTGRES_PASSWORD=

# ── Redis (per-app container, password + noeviction) ────────────────────────
REDIS_PASSWORD=
# REDIS_URL is composed into each service as redis://:<REDIS_PASSWORD>@redis:6379
REDIS_URL=

# ── Object storage — Cloudflare R2 S3 API (was MinIO) ──────────────────────
# Create an R2 API token scoped to the bucket and set S3_REGION=auto.
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=quizzeira-objects
S3_FORCE_PATH_STYLE=true

# ── Internal service wiring (docker DNS on quizzeira-internal) ─────────────
DISCOVERY_API_URL=http://discovery-api:3010
CONTENT_API_URL=http://content-api:3020
DOC_PROCESSOR_URL=http://doc-processor:3030
INTERNAL_API_URL=http://api:3000
# Scoped internal keys (never ship dev defaults). API also accepts
# INTERNAL_API_KEYS=key:scopes pairs.
INTERNAL_API_KEY=
INTERNAL_API_KEY_CORRECTOR=
INTERNAL_API_KEY_DISCOVERY=
INTERNAL_API_KEY_CONTENT=
INTERNAL_RATE_LIMIT_MAX=120

# ── JWT / auth ──────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Gemini ──────────────────────────────────────────────────────────────────
# LLM_PROVIDER is unset in prod; tests set it to `fixture`.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── JEV ─────────────────────────────────────────────────────────────────────
# One key per stack. Unset JEV_*_MODE → active when JEV_API_KEY is present.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
# Pin jev-1.13.0 until Portuguese holdout passes; then promote to jev-1.14.0.
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_SECONDS=10
# Per-task authority: off | shadow | active (unset → active with key, off without).
# Prefer active in prod; shadow is staging/holdout only (double-pays Gemini+JEV).
# Never leave production on shadow.
JEV_CLASSIFY_MODE=active
JEV_MAPPING_MODE=active
JEV_JUDGE_MODE=active
JEV_CORRECTOR_MODE=active
# Shadow-call isolation (only consumed in shadow mode)
JEV_SHADOW_RATE_PER_MINUTE=10
JEV_SHADOW_DAILY_CALLS=500
LLM_RATE_LIMIT_PER_MINUTE=20
LLM_DAILY_BUDGET=500
LLM_DAILY_TOKEN_BUDGET=2000000
LLM_RATE_GENERATION_PER_MINUTE=1
LLM_RATE_JUDGE_PER_MINUTE=1
LLM_BUDGET_KU_TOKENS=500000
LLM_BUDGET_GENERATION_TOKENS=800000
LLM_BUDGET_JUDGE_TOKENS=400000
LLM_BUDGET_RESIDUE_TOKENS=200000
LLM_CACHE_TTL_DAYS=90

# ── HTTP limits ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=1000

# ── Logging ─────────────────────────────────────────────────────────────────
SERVICE_NAME=quizzeira-api
LOG_LEVEL=info

# ── Workers (interval / schedule) ───────────────────────────────────────────
WORKER_INTERVAL_MS=60000
WORKER_TZ=UTC
WORKER_WINDOWS=

# ── Ingestion / discovery-crawler (profile discovery) ──────────────────────
DISCOVERY_CRAWLER_ENABLED=true
DISCOVERY_CRAWLER_FIXTURE_MODE=false
DISCOVERY_CRAWLER_INTERVAL_MS=1800000
DISCOVERY_CRAWLER_MAX_SOURCES=6
DISCOVERY_CRAWLER_MAX_OPEN_PER_SOURCE=8
DISCOVERY_CRAWLER_MAX_ARTIFACTS=4
DISCOVERY_CRAWLER_MAX_OAB_EDITIONS=3
DISCOVERY_CRAWLER_NAV_TIMEOUT_MS=45000
# Optional web search for topic-query discovery (else allowlist-only; no Firecrawl)
# SEARCH_API_URL=
# SEARCH_API_KEY=

# ── Exam lifecycle (profile discovery) ─────────────────────────────────────
DISCOVERY_LIFECYCLE_ENABLED=true
DISCOVERY_LIFECYCLE_INTERVAL_MS=900000
DISCOVERY_LIFECYCLE_DRY_RUN=true
DISCOVERY_LIFECYCLE_CALENDAR_GC=true
DISCOVERY_LIFECYCLE_SOFT_ARCHIVE_DAYS=30
DISCOVERY_LIFECYCLE_HARD_DELETE_DAYS=90
DISCOVERY_LIFECYCLE_DROP_TOMBSTONE=false
DISCOVERY_LIFECYCLE_BATCH_SIZE=50

# ── Social scout (profile social) — public/consented feeds only, off by default ──
DISCOVERY_SOCIAL_ENABLED=false
DISCOVERY_SOCIAL_FIXTURE_MODE=true
DISCOVERY_SOCIAL_STORE_URL_ARTIFACTS=false
DISCOVERY_SOCIAL_LOCALE=pt-BR
DISCOVERY_SOCIAL_ADAPTERS=fixture
DISCOVERY_SOCIAL_INTERVAL_MS=3600000
DISCOVERY_SOCIAL_MAX_POSTS=40
DISCOVERY_SOCIAL_MAX_FILES=12
# DISCOVERY_SOCIAL_KEYWORDS=             # overrides pt-BR defaults
# DISCOVERY_SOCIAL_KEYWORDS_EXTRA=

# Curated official portal scout (SourceCandidate only; admin promotes)
DISCOVERY_SOURCE_SCOUT_ENABLED=false
DISCOVERY_SOURCE_SCOUT_INTERVAL_MS=3600000
DISCOVERY_SOURCE_SCOUT_MAX_PER_PASS=6
DISCOVERY_SOURCE_SCOUT_PRIORITY=P0

# Heal broken/stale listing Sources
DISCOVERY_PORTAL_MONITOR_ENABLED=false
DISCOVERY_PORTAL_MONITOR_INTERVAL_MS=1800000
DISCOVERY_PORTAL_MONITOR_MAX_PER_PASS=8
DISCOVERY_PORTAL_MONITOR_FORCE_CRAWL=true
DISCOVERY_PORTAL_MONITOR_STALE_HOURS=36
DISCOVERY_PORTAL_MONITOR_PROBE_TIMEOUT_MS=15000

# Legislation amendment watcher (content plane; no Gemini/JEV calls)
CONTENT_FRESHNESS_ENABLED=false
CONTENT_FRESHNESS_DRY_RUN=true
CONTENT_FRESHNESS_INTERVAL_MS=21600000
CONTENT_FRESHNESS_MAX_PER_PASS=8
CONTENT_FRESHNESS_PROBE_TIMEOUT_MS=15000
# Live adapters (omit → adapter disabled)
# X_BEARER_TOKEN=
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_IDS=
# FACEBOOK_ACCESS_TOKEN=
# FACEBOOK_PAGE_IDS=
# META_GRAPH_ACCESS_TOKEN=
# YOUTUBE_API_KEY=
# TELEGRAM_BOT_TOKEN=
# REDDIT_SUBREDDITS=concursos,brasil
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=
# REDDIT_ALLOW_ANONYMOUS=false

# ── Extraction / Embeddings / Generation (content-worker, profile content) ──
CONTENT_WORKER_INTERVAL_MS=120000
CONTENT_WORKER_WINDOWS=
CONTENT_EXTRACTION_ENABLED=true
CONTENT_EMBEDDINGS_ENABLED=true
CONTENT_GENERATION_ENABLED=true
CONTENT_DOCS_PER_PASS=3
CONTENT_CHUNKS_PER_EMBED_PASS=32
CONTENT_QUESTIONS_PER_RUN=6
CONTENT_PUBLISHED_TARGET=40
CONTENT_RETRIEVAL_TOP_K=8
# Must match the vector(768) column in quizzeira_content.
CONTENT_EMBEDDING_DIMENSIONS=768
# Embedding id is GEMINI_EMBEDDING_MODEL above (gemini-embedding-001 @ 768).
CONTENT_TRIAGE_ENABLED=true
CONTENT_TRIAGE_INTERVAL_SEC=21600
CONTENT_TRIAGE_RECLASSIFY=true
CONTENT_TRIAGE_PRUNE=true
CONTENT_RETENTION_ENABLED=true
CONTENT_RETENTION_GRACE_DAYS=7

# ── Eval / publish gate (content-quality, profile content) ─────────────────
CONTENT_QUALITY_ENABLED=true
CONTENT_QUALITY_INTERVAL_MS=60000
CONTENT_QUALITY_ITEMS_PER_PASS=10
CONTENT_QUALITY_PUBLISH_THRESHOLD=0.8
CONTENT_QUALITY_JUDGE_TIER=cheap
CONTENT_QUALITY_FAIL_THRESHOLD=0.5
CONTENT_QUALITY_PUBLISH_EXTRACTION_WITHOUT_JUDGE=false

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production
GIT_SHA=
# PORT=                    # fixed per service (3000/3010/3020/3030/3012/3013)

# ── Seed / demo (panel-only; migrations + users seed use DEV_ROOT_*) ────────
DEV_ROOT_EMAIL=
DEV_ROOT_PASSWORD=
DEMO_PASSWORD=

# ── Rollback switch ─────────────────────────────────────────────────────────
# SKIP_MIGRATIONS=1       # set only for rollback deploys

# ── CI runner smoke overrides (not pasted into Dokploy) ─────────────────────
# LLM_PROVIDER=fixture, REDIS_URL set by smoke compose, DATABASE/DISCOVERY/CONTENT_*_URL
# point at the runner's postgres container.
