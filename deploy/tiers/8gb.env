# Quizzeira memory budget — 8 GB VPS tier (see infra docs RUNBOOK-REBUILD).
# Core budget ≤ 1750 MB; content + discovery profiles OFF at this tier
# (enable on demand only — the runner/WebSocket API stays alive).
#
# Core (sum = 1728 MB ≤ 1750): NOTE content profile cannot run at this tier.
MEM_REDIS=192m
MEM_API=640m
MEM_DISCOVERY_API=320m
MEM_CONTENT_API=320m
MEM_QUIZ_CORRECTOR=256m
# Content profile (doc-processor 448 + content-worker 640 + content-quality 192 = 1280 MB)
MEM_DOC_PROCESSOR=448m
MEM_CONTENT_WORKER=640m
MEM_CONTENT_QUALITY=192m
# Discovery profile (crawler 1408 + lifecycle 192 = 1600 MB)
MEM_DISCOVERY_CRAWLER=1408m
MEM_DISCOVERY_LIFECYCLE=192m
# Social profile
MEM_SOCIAL=192m
