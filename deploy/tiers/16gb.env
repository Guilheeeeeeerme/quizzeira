# Quizzeira memory budget — 16 GB VPS tier (see infra docs RUNBOOK-REBUILD).
# Core budget ≤ 2400 MB; content + discovery profiles ≤ 4400 MB combined; social tiny extra.
#
# Core (sum = 2304 MB ≤ 2400):
MEM_REDIS=256m
MEM_API=768m
MEM_DISCOVERY_API=384m
MEM_CONTENT_API=512m
MEM_QUIZ_CORRECTOR=384m
# Content profile (doc-processor 512 + content-worker 768 + content-quality 256 = 1536 MB)
MEM_DOC_PROCESSOR=512m
MEM_CONTENT_WORKER=768m
MEM_CONTENT_QUALITY=256m
# Discovery profile (crawler 1536 + lifecycle 256 = 1792 MB);
# content + discovery = 3328 MB ≤ 4400.
MEM_DISCOVERY_CRAWLER=1536m
MEM_DISCOVERY_LIFECYCLE=256m
# Social profile (small extra on top)
MEM_SOCIAL=192m
