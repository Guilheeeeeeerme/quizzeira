# URLs
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost

# Database
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=quizzeira
MYSQL_PASSWORD=quizzeira
MYSQL_DATABASE=quizzeira
DATABASE_URL=mysql://quizzeira:quizzeira@mysql:3306/quizzeira

# Redis
REDIS_URL=redis://redis:6379

# Shared exam question bank (Redis document hashes). TTL in days.
QUESTION_BANK_TTL_DAYS=90
# Opt-in Firecrawl past-exam / prova search (API calls from the API service).
# Leave FIRECRAWL_API_KEY empty to skip live search; bank still works via seed/LLM deposit.
FIRECRAWL_API_KEY=
PAST_EXAM_SEARCH_ENABLED=true
PAST_EXAM_SEARCH_COOLDOWN_SEC=3600

# Rate limiting (default: 5 requests per second)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=1000

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# App
NODE_ENV=development
PORT=3000

# Object storage (MinIO / S3)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=quizzeira
S3_SECRET_ACCESS_KEY=quizzeira-secret
S3_BUCKET=quizzeira
S3_FORCE_PATH_STYLE=true

# Frontend (Vite)
VITE_API_ORIGIN=http://localhost:3000

# Internal DMZ (workers → API). Change in production.
# Legacy full-access key (break-glass). Prefer per-worker keys below.
INTERNAL_API_KEY=dev-internal-key
INTERNAL_API_KEY_CORRECTOR=dev-corrector-key
INTERNAL_API_KEY_GENERATOR=dev-generator-key
INTERNAL_API_KEY_UPDATER=dev-updater-key
INTERNAL_API_KEY_CRAWLER=dev-crawler-key
# Docker DNS (service `api`). Host-side npm run: INTERNAL_API_URL=http://localhost:3000
INTERNAL_API_URL=http://api:3000

# Gemini (workers). Do not commit real keys.
GEMINI_API_KEY=
# Cheapest generateContent model on this API: gemini-2.5-flash-lite ($0.10/$0.40 per 1M).
# Alias gemini-flash-lite-latest tracks newest lite (not cheapest).
GEMINI_MODEL=gemini-2.5-flash-lite
# Code defaults to https://generativelanguage.googleapis.com. Point at local Headroom:
GEMINI_BASE_URL=http://localhost:8787

# Worker schedule (default 1 minute)
WORKER_INTERVAL_MS=60000

# LLM providers (workers). Leave a key empty to skip that provider.
# Do not commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
# Code defaults to https://api.openai.com/v1. Point at local Headroom:
OPENAI_BASE_URL=http://localhost:8787/v1
# Provider fallback order (left = preferred). Unknown names ignored; providers
# without a key are skipped. No key set at all -> workers skip every tick.
LLM_PROVIDER_ORDER=gemini,openai

# Cheapest-model ranking for workers (input USD/1M seeds, best-effort models.list
# enrichment). Refresh every 12h; expose the N cheapest models per provider.
MODEL_RANK_REFRESH_MS=43200000
MODEL_RANK_TOP_N=3

# LLM spend guardrails (Redis-shared when REDIS_URL is set on workers).
LLM_RATE_LIMIT_PER_MINUTE=20
LLM_DAILY_BUDGET=500
LLM_DAILY_TOKEN_BUDGET=2000000
INTERNAL_RATE_LIMIT_MAX=120
# Opt-in Gemini Search for question-updater (proposals still require admin HITL).
QUESTION_UPDATE_GROUNDING=false
# Comma-separated HTTPS host suffixes allowed in question media (default: wikimedia).
#MEDIA_URL_ALLOWLIST=upload.wikimedia.org,wikimedia.org

# Open-exam crawler (Playwright npm — NOT Cursor MCP).
# Runs every 30m (2×/hour). Unchanged listings are skipped via fingerprints;
# past-exam search only when an open exam is new/changed and the bank is empty.
EXAM_CRAWLER_ENABLED=true
# true = local fixtures (reliable catalog fill); false = live Playwright navigation
EXAM_CRAWLER_FIXTURE_MODE=true
EXAM_CRAWLER_INTERVAL_MS=1800000
EXAM_CRAWLER_WINDOWS=
EXAM_CRAWLER_MAX_SOURCES=4
EXAM_CRAWLER_MAX_OPEN_PER_SOURCE=8
EXAM_CRAWLER_MAX_SEARCHES=2

# Optional worker windows "HH:MM,HH:MM" (empty = continuous). Docker compose runs
# question-updater 2x/day by default (07:00,19:00 UTC). quiz-corrector stays
# continuous unless you set WORKER_WINDOWS (batch mode). |now - window| <= 30min.
#WORKER_WINDOWS=07:00,19:00
WORKER_TZ=UTC