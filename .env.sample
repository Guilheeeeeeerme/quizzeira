# URLs
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost

# Study + Discovery + Content (Postgres / pgvector). Prod = Supabase Free schemas.
#
# Database switch (gitignored — never commit passwords):
#   .env              → remote Supabase (quizzeira_study / discovery / content)
#   .env.local.docker → standalone Compose Postgres (scripts/local-postgres-init.sh)
# Remote from WSL:
#   bash ../infra/scripts/supabase_dev_tunnel.sh -f
#   python3 ../infra/scripts/write_local_supabase_env.py
# → 127.0.0.1:15432. Study is Postgres (not MySQL).
#
# Placeholders below = local-db shape (also .env.local.docker).
POSTGRES_USER=quizzeira
POSTGRES_PASSWORD=quizzeira
DATABASE_URL=postgresql://quizzeira:quizzeira@postgres:5432/quizzeira_study?schema=public
DATABASE_DIRECT_URL=postgresql://quizzeira:quizzeira@postgres:5432/quizzeira_study?schema=public
DISCOVERY_DATABASE_URL=postgresql://quizzeira:quizzeira@postgres:5432/quizzeira_discovery
DISCOVERY_DATABASE_DIRECT_URL=postgresql://quizzeira:quizzeira@postgres:5432/quizzeira_discovery
CONTENT_DATABASE_URL=postgresql://quizzeira:quizzeira@postgres:5432/quizzeira_content
CONTENT_DATABASE_DIRECT_URL=postgresql://quizzeira:quizzeira@postgres:5432/quizzeira_content
DISCOVERY_API_URL=http://discovery-api:3010
CONTENT_API_URL=http://content-api:3020
DOC_PROCESSOR_URL=http://doc-processor:3030
# Optional web search for topic-query discovery (GET ?q=&limit= → {results:[{url,title,snippet}]})
# SEARCH_API_URL=
# SEARCH_API_KEY=
LLM_BUDGET_KU_TOKENS=500000
LLM_BUDGET_GENERATION_TOKENS=800000
LLM_BUDGET_JUDGE_TOKENS=400000
LLM_BUDGET_RESIDUE_TOKENS=200000
LLM_CACHE_TTL_DAYS=90

# Redis (rate limit + LLM budgets only)
REDIS_URL=redis://redis:6379

SERVICE_NAME=quizzeira-api
LOG_LEVEL=info

RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=1000

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

NODE_ENV=development
PORT=3000
# Cursor benchmark isolation (do not collide with other implementations):
# COMPOSE_PROJECT_NAME=quizzeira-cursor
# RALPH_PORT_BASE=4340
# Publish study API on 4340 when running alongside other worktrees:
# PORT=4340
# API_ORIGIN=http://localhost:4340
# WEB_ORIGIN=http://localhost:4341

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=quizzeira
S3_SECRET_ACCESS_KEY=quizzeira-secret
S3_BUCKET=quizzeira
S3_FORCE_PATH_STYLE=true

VITE_API_ORIGIN=http://localhost:3000

INTERNAL_API_KEY=dev-internal-key
INTERNAL_API_KEY_CORRECTOR=dev-corrector-key
INTERNAL_API_KEY_DISCOVERY=dev-discovery-key
INTERNAL_API_KEY_CONTENT=dev-content-key
INTERNAL_API_URL=http://api:3000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Headroom switch for Gemini + OpenAI (PromptDesk / Argus use ON in prod).
# Quizzeira Compose workers force LLM_USE_HEADROOM=false (direct providers).
#   true  → GEMINI_BASE_URL / OPENAI_BASE_URL point at Headroom
#   false → public APIs even if URLs still look like Headroom
LLM_USE_HEADROOM=true
GEMINI_BASE_URL=http://localhost:8787
OPENAI_BASE_URL=http://localhost:8787/v1

WORKER_INTERVAL_MS=60000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_BASE_URL=http://localhost:8787/v1
LLM_PROVIDER_ORDER=gemini,openai
# Deterministic E2E / CI compose (§41.3): set LLM_PROVIDER=fixture so content-worker,
# content-quality, and quiz-corrector use packages/worker-kit recorded responses
# instead of live Gemini/OpenAI. docker-compose passes this through via env_file +
# LLM_PROVIDER: ${LLM_PROVIDER:-}. Leave unset for normal local LLM calls.
# LLM_PROVIDER=fixture

MODEL_RANK_REFRESH_MS=43200000
MODEL_RANK_TOP_N=3

LLM_RATE_LIMIT_PER_MINUTE=20
LLM_DAILY_BUDGET=500
LLM_DAILY_TOKEN_BUDGET=2000000
INTERNAL_RATE_LIMIT_MAX=120

# Ingestion (discovery-crawler) — sources come from admin, never from seed
DISCOVERY_CRAWLER_ENABLED=true
DISCOVERY_CRAWLER_FIXTURE_MODE=false
DISCOVERY_CRAWLER_INTERVAL_MS=1800000
DISCOVERY_CRAWLER_MAX_SOURCES=6
DISCOVERY_CRAWLER_MAX_OPEN_PER_SOURCE=8
DISCOVERY_CRAWLER_MAX_ARTIFACTS=4

# Social signal scout (discovery-social-scout) — public/consented feeds only; off by default
# Default locale/keywords are Brazilian Portuguese (pt-BR) concurso vocabulary.
DISCOVERY_SOCIAL_ENABLED=false
DISCOVERY_SOCIAL_FIXTURE_MODE=true
DISCOVERY_SOCIAL_STORE_URL_ARTIFACTS=false
DISCOVERY_SOCIAL_LOCALE=pt-BR
# Comma list: fixture,x-public,google-cse,instagram-graph,facebook-graph,reddit-public,youtube-data,telegram-public
DISCOVERY_SOCIAL_ADAPTERS=fixture
DISCOVERY_SOCIAL_INTERVAL_MS=3600000
DISCOVERY_SOCIAL_MAX_POSTS=40
DISCOVERY_SOCIAL_MAX_FILES=12
# Override built-in pt-BR defaults (edital, inscrição, gabarito, Cebraspe, FCC, FGV, …):
# DISCOVERY_SOCIAL_KEYWORDS=concurso edital,concurso inscrição,concurso gabarito,OAB edital,Cebraspe edital,FCC concurso,FGV concurso
# Optional English / niche extras (appended; not defaults):
# DISCOVERY_SOCIAL_KEYWORDS_EXTRA=civil service exam
# DISCOVERY_SOCIAL_SMOKE=false
# Live adapters (omit → adapter status=disabled, empty posts; service still boots)
# X_BEARER_TOKEN=
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_IDS=
# FACEBOOK_ACCESS_TOKEN=
# FACEBOOK_PAGE_IDS=
# META_GRAPH_ACCESS_TOKEN=
# YOUTUBE_API_KEY=
# TELEGRAM_BOT_TOKEN=
# REDDIT_SUBREDDITS=concursos,brasil
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=
# REDDIT_ALLOW_ANONYMOUS=false   # public .json without OAuth; opt-in only

# Extraction / Embeddings / Generation (content-worker)
CONTENT_WORKER_INTERVAL_MS=120000
CONTENT_EXTRACTION_ENABLED=true
CONTENT_EMBEDDINGS_ENABLED=true
CONTENT_GENERATION_ENABLED=true
CONTENT_DOCS_PER_PASS=3
CONTENT_CHUNKS_PER_EMBED_PASS=32
CONTENT_QUESTIONS_PER_RUN=6
CONTENT_PUBLISHED_TARGET=40
CONTENT_RETRIEVAL_TOP_K=8
# Must match the vector(768) column in quizzeira_content.
CONTENT_EMBEDDING_DIMENSIONS=768
CONTENT_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CONTENT_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Eval / publish gate (content-quality) — the only path to `published`
CONTENT_QUALITY_ENABLED=true
CONTENT_QUALITY_INTERVAL_MS=60000
CONTENT_QUALITY_ITEMS_PER_PASS=10
CONTENT_QUALITY_PUBLISH_THRESHOLD=0.8
CONTENT_QUALITY_JUDGE_TIER=cheap
CONTENT_QUALITY_FAIL_THRESHOLD=0.5
# Publish structurally-ok past-exam extraction when LLM judge is unavailable.
CONTENT_QUALITY_PUBLISH_EXTRACTION_WITHOUT_JUDGE=false

WORKER_TZ=UTC

# Users-only seed (admin root). No content seed.
DEV_ROOT_EMAIL=root@quizzeira.local
DEV_ROOT_PASSWORD=Password123!
DEMO_PASSWORD=Password123!
